rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if true;
      allow write: if request.auth.uid == document;
      allow delete: if false;
    }

    match /ride/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.user_uid;
    }

    match /users/{parent}/favouriteLocations/{document} {
      allow create: if request.auth.uid == parent;
      allow read: if true;
      allow write: if request.auth.uid == parent;
      allow delete: if request.auth.uid == parent;
    }

    match /IncidentsDB/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth != null;
    }

    match /IncidentsDB/{parent}/category/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth != null;
    }

    match /{path=**}/category/{document} {
      allow read: if request.auth != null;
    }


    match /IncidentsDB/{parent}/subcategory/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if request.auth != null;
    }

    match /{path=**}/subcategory/{document} {
      allow read: if request.auth != null;
    }


    match /ride/{parent}/assignment/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /{path=**}/assignment/{document} {
      allow read: if true;
    }

  }
}
